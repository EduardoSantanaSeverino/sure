<%# locals: (entry:, balance_trend: nil, view_ctx: "account", in_split_group: false, running_balance: nil) %>
<% trade = entry.entryable %>
<% has_running_balance = defined?(running_balance) && running_balance.present? %>

<%= turbo_frame_tag dom_id(entry) do %>
  <%= turbo_frame_tag dom_id(trade) do %>
    <div class="group flex items-center gap-2 lg:gap-3 text-primary text-sm font-medium py-2 px-3 <%= "pl-6 lg:pl-8" if in_split_group %> border-b border-primary/5 last:border-b-0 <%= "opacity-50 text-secondary" if entry.excluded %>">
      <%# ☐ mint %>
      <div class="hidden lg:flex w-8 shrink-0 justify-center">
        <%= check_box_tag dom_id(entry, "selection"),
            class: "checkbox checkbox--light",
            data: {
              id: entry.id,
              entry_type: entry.entryable_type,
              "bulk-select-target": "row",
              action: "bulk-select#toggleRowSelection",
              checkbox_toggle_target: "selectionEntry"
            } %>
      </div>

      <%# DATE mint — respects Settings date_format via format_date %>
      <% if has_running_balance %>
        <div class="hidden lg:flex w-[110px] shrink-0 text-secondary text-sm truncate pr-2"><%= format_date(entry.date) %></div>
      <% end %>

      <%# TRANSACTION flex 2 %>
      <div class="flex items-center gap-2 lg:gap-3 flex-[2] min-w-0 pr-2">
        <div class="min-w-0 flex-1">
          <div class="truncate">
            <%= link_to entry.name,
                        entry_path(entry),
                        data: { turbo_frame: "drawer", turbo_prefetch: false },
                        class: "hover:underline truncate" %>
          </div>
          <% if view_ctx == "global" %>
            <div class="text-secondary text-xs font-normal truncate"><%= entry.account.name %></div>
          <% end %>
        </div>
      </div>

      <%# NOTES flex 2 %>
      <div class="hidden lg:flex min-w-0 flex-[2] px-2">
        <% if entry.notes.present? %>
          <span class="whitespace-pre-wrap break-words text-sm text-secondary privacy-sensitive" title="<%= entry.notes %>"><%= entry.notes %></span>
        <% else %>
          <span class="text-secondary/40 text-sm">—</span>
        <% end %>
      </div>

      <%# CATEGORY flex 1 %>
      <div class="hidden md:flex min-w-0 items-center gap-1 flex-[1]">
        <%= render "investment_activity/quick_edit_badge", entry: entry, entryable: trade %>
      </div>

      <%# AMOUNT mint %>
      <div class="w-[120px] shrink-0 flex items-center justify-end gap-2 <%= "opacity-50" if entry.excluded %>">
        <% if entry.protected_from_sync? && !entry.excluded? %>
          <%= link_to entry_path(entry), data: { turbo_frame: "drawer", turbo_prefetch: false }, class: "invisible group-hover:visible transition-opacity", title: t("entries.protection.tooltip") do %>
            <%= icon "lock", size: "sm", class: "text-secondary" %>
          <% end %>
        <% end %>
        <%= content_tag :p,
            format_money(-entry.amount_money),
            class: ["privacy-sensitive text-sm font-medium truncate", "text-green-600": entry.amount.negative?] %>
      </div>

      <%# BALANCE mint %>
      <% if has_running_balance %>
        <div class="hidden lg:flex w-[120px] shrink-0 justify-end px-2">
          <span class="privacy-sensitive text-sm font-medium text-primary truncate" title="<%= format_money(running_balance) %>"><%= format_money(running_balance) %></span>
        </div>
      <% end %>
    </div>
  <% end %>
<% end %>
